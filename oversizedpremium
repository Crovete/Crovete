<script>
const products = [{name:'Brown',img:'data:image/jpeg;base64,'},{name:'Beige',img:'data:image/jpeg;base64,'},{name:'White',img:'data:image/jpeg;base64,'},{name:'Yellow',img:'data:image/jpeg;base64,'},{name:'Black',img:'data:image/jpeg;base64,'},{name:'Lavender',img:'data:image/jpeg;base64,'},{name:'Acid Wash',img:'data:image/jpeg;base64,'},{name:'Royal Blue',img:'data:image/jpeg;base64,'},{name:'Red',img:'data:image/jpeg;base64,'}];
let selectedProduct = null;
let cart = [];

function selectProduct(index) {
  selectedProduct = products[index];

  document.getElementById("selectedName").textContent = selectedProduct.name;
  document.getElementById("selectedImg").src = selectedProduct.img;

  ["S","M","L","XL","XXL"].forEach(function(size) {
    document.getElementById("count-" + size).value = 0;
  });

  updateModalSummary();
  document.getElementById("modal").style.display = "flex";
}


function getModalQuantities() {
  const sizes = ["S","M","L","XL","XXL"];
  const q = {};
  sizes.forEach(function(size) {
    let n = parseInt(document.getElementById("count-" + size).value, 10);
    if (isNaN(n) || n < 0) n = 0;
    q[size] = n;
  });
  return q;
}

function syncSize(size, value) {
  let n = parseInt(value, 10);
  if (isNaN(n) || n < 0) n = 0;
  document.getElementById("count-" + size).value = n;
  updateModalSummary();
}

function changeSize(size, amount) {
  const input = document.getElementById("count-" + size);
  let n = parseInt(input.value, 10);
  if (isNaN(n)) n = 0;
  input.value = Math.max(0, n + amount);
  updateModalSummary();
}

function updateModalSummary() {
  const q = getModalQuantities();
  const total = Object.values(q).reduce(function(a,b){ return a+b; }, 0);
  const pricing = getPricing(total);
  const price = pricing.price;
  const next = pricing.nextQty;
  const nextPrice = pricing.nextPrice;

  document.getElementById("modalQty").textContent = total;
  const deal = document.getElementById("modalDeal");

  if (total === 0) {
    deal.innerHTML = '<span class="deal-more">Start your order</span><span class="deal-sub">Add quantities to unlock lower prices</span>';
  } else if (next) {
    const more = next - total;
    deal.innerHTML = '<span class="deal-more">Add ' + more + ' more ' + (more === 1 ? 'item' : 'items') + ' → <span class="deal-price">₹' + nextPrice + '/pc</span></span><span class="deal-sub">Current: ₹' + price + '/pc</span>';
  } else {
    deal.innerHTML = '<span class="deal-more">BEST PRICE <span class="deal-price">₹339/pc</span></span><span class="deal-sub">Lowest available price</span>';
  }
}

function closeProduct() {
  document.getElementById("modal").style.display = "none";
}

function addToCart() {
  if (!selectedProduct) {
    alert("Please select a T-shirt first.");
    return;
  }

  const sizes = ["S","M","L","XL","XXL"];
  let added = false;

  sizes.forEach(function(size) {
    const input = document.getElementById("count-" + size);
    let qty = parseInt(input.value, 10);

    if (isNaN(qty) || qty < 0) qty = 0;

    if (qty > 0) {
      cart.push({
        name: selectedProduct.name,
        size: size,
        qty: qty
      });
      added = true;
    }
  });

  if (!added) {
    alert("Please enter quantity for at least one size.");
    return;
  }

  renderCart();
  closeProduct();
}

const PRICING_TIERS = [
  { min: 1, max: 3, price: 450, nextQty: 4, nextPrice: 400 },
  { min: 4, max: 999, price: 400, nextQty: 1000, nextPrice: 360 },
  { min: 1000, max: 9999, price: 360, nextQty: 10000, nextPrice: 339 },
  { min: 10000, max: 100000, price: 339, nextQty: null, nextPrice: null }
];

function getPricing(totalQty) {
  totalQty = Math.max(0, Number(totalQty) || 0);
  if (totalQty === 0) return { price: 450, nextQty: 1, nextPrice: 450 };
  for (const tier of PRICING_TIERS) {
    if (totalQty >= tier.min && totalQty <= tier.max) return tier;
  }
  // Keep the lowest available price for quantities above the published maximum.
  return PRICING_TIERS[PRICING_TIERS.length - 1];
}


function colorDot(name){
  const map = {
    "White":"#ffffff","Beige":"#f3ead7","Brown":"#76543e","Red":"#c9252d","Green":"#087f5b","Grey":"#9b9b9b",
    "Melange Grey":"#aaa9a5","Navy Blue":"#102a56","Olive Green":"#77734a","Lavender":"#b9a2d0",
    "Royal Blue":"#2459d3","Yellow":"#ffd21c","Black":"#111111","Acid Wash":"#777b80"
  };
  return map[name] || "#777777";
}

function getCartQuantity() {
  return cart.reduce(function(total, item) {
    return total + Number(item.qty || 0);
  }, 0);
}

function updatePriceBox() {
  const totalQty = getCartQuantity();
  const pricing = getPricing(totalQty);
  document.getElementById("unitPrice").textContent = "₹" + pricing.price + " / pc";
  document.getElementById("totalAmount").textContent = "₹" + (totalQty * pricing.price);

  let message = "";
  if (totalQty === 0) {
    message = "Add 1 item to start — ₹450 per piece";
  } else if (pricing.nextQty) {
    const more = pricing.nextQty - totalQty;
    message = "Add " + more + " more " + (more === 1 ? "item" : "items") +
              " to get ₹" + pricing.nextPrice + " per piece";
  } else {
    message = "Best price unlocked: ₹339 per piece";
  }
  document.getElementById("priceMessage").textContent = message;
}

function renderCart() {
  const el = document.getElementById("cartItems");

  if (cart.length === 0) {
    el.innerHTML = '<div style="font-size:13px;color:#777">No items added yet.</div>';
    updatePriceBox();
    return;
  }

  el.innerHTML = "";

  cart.forEach(function(item, index) {
    const row = document.createElement("div");
    row.className = "cart-item";
    const badgeRow = document.createElement("div");
    badgeRow.className = "cart-badge-row";
    const color = document.createElement("span");
    color.className = "cart-color-badge";
    const dot = document.createElement("i");
    dot.className = "cart-color-dot";
    dot.style.setProperty("--dot", colorDot(item.name));
    const colorName = document.createElement("span");
    colorName.textContent = item.name;
    color.appendChild(dot);
    color.appendChild(colorName);
    const size = document.createElement("span");
    size.className = "cart-size-badge";
    size.textContent = "Size " + item.size;
    const qty = document.createElement("span");
    qty.className = "cart-qty-badge";
    qty.innerHTML = "QTY <b>" + item.qty + "</b>";
    badgeRow.appendChild(color);
    badgeRow.appendChild(size);
    badgeRow.appendChild(qty);
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "remove";
    remove.textContent = "REMOVE";
    remove.onclick = function() { cart.splice(index,1); renderCart(); };
    row.appendChild(badgeRow);
    row.appendChild(remove);
    el.appendChild(row);
  });

  updatePriceBox();
}

function placeOrder() {
  if (cart.length === 0) {
    alert("Add a T-shirt to cart first.");
    return;
  }

  const totalQty = getCartQuantity();
  const pricing = getPricing(totalQty);

  let message = "Crovete Blank Premium Oversized - Oversized 240 GSM\n\n";

  cart.forEach(function(item) {
    message += item.name + " - Size " + item.size + " - Qty " + item.qty + "\n";
  });

  message += "\nTotal Quantity: " + totalQty;
  message += "\nPrice Per Piece: ₹" + pricing.price;
  message += "\nTotal Amount: ₹" + (totalQty * pricing.price);

  const phone = "919356259467";
  const url = "https://wa.me/" + phone + "?text=" + encodeURIComponent(message);

  window.open(url, "_blank");
}
</script>
